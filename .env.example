# Neon Postgres connection string (Neon console > Connect, or added for you by the Vercel Neon integration)
DATABASE_URL=

# Resend. Optional until you verify a domain: with these empty, sign-ups are still saved, just no welcome email.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. 99 Names <hello@yourdomain.com>
RESEND_FROM=

# Public URL of the site, used in the unsubscribe link. On Vercel this falls back to the production URL.
NEXT_PUBLIC_SITE_URL=

# Any random string. Used to hash IP addresses for rate limiting.
IP_HASH_SALT=
