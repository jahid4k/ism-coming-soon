# Copy this file to .env.local and fill it in. Never put real values in this file: it is committed to git.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Must start with mongodb:// or mongodb+srv://
# Atlas > Network Access must allow your IP (and 0.0.0.0/0 for Vercel).
DATABASE_URL=
# Optional. Database name inside the cluster. Defaults to ism_coming_soon.
DATABASE_NAME=

# Gmail SMTP. Optional: with these empty, sign-ups are still saved, just no welcome email.
# GMAIL_APP_PASSWORD is NOT your Gmail password. Turn on 2-Step Verification, then create one at
# https://myaccount.google.com/apppasswords (16 characters, spaces optional).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Public URL of the site, used in the unsubscribe link. On Vercel this falls back to the production URL.
NEXT_PUBLIC_SITE_URL=

# Any random string. Used to hash IP addresses for rate limiting.
IP_HASH_SALT=
